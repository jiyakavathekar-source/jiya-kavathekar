#include <iostream>
using namespace std;

class Library
{
protected:
    int id;
    string title;

public:
    void getdata()
    {
        cout << "Enter ID: ";
        cin >> id;

        cout << "Enter Title: ";
        cin >> title;
    }
};

class Book : public Library
{
public:
    void display()
    {
        cout << "\nBook ID: " << id;
        cout << "\nBook Title: " << title << endl;
    }
};

class Magazine : public Library
{
public:
    void display()
    {
        cout << "\nMagazine ID: " << id;
        cout << "\nMagazine Title: " << title << endl;
    }
};

int main()
{
    Book b;
    Magazine m;

    cout << "Enter Book Details:\n";
    b.getdata();
    b.display();

    cout << "\nEnter Magazine Details:\n";
    m.getdata();
    m.display();

    return 0;
}
